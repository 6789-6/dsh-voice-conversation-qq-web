# Keep this file free of real credentials. Point each *_FILE at a private file.
VOICE_BRIDGE_UPSTREAM_URL=ws://127.0.0.1:9001
VOICE_BRIDGE_UPSTREAM_TOKEN_FILE=/run/secrets/onebot-upstream-token
VOICE_BRIDGE_DOWNSTREAM_TOKEN_FILE=/run/secrets/onebot-downstream-token
VOICE_BRIDGE_ALLOWED_SENDERS_FILE=/run/secrets/qq-allowed-senders
VOICE_BRIDGE_ASR_URL=http://127.0.0.1:9002/v1/asr
VOICE_BRIDGE_ASR_TOKEN_FILE=/run/secrets/asr-token
VOICE_BRIDGE_HOST=127.0.0.1
VOICE_BRIDGE_PORT=3092
