{
  "name": "dsh-voice-conversation-qq-web",
  "version": "0.1.2",
  "description": "Fish Audio TTS with optional SenseVoice ASR for DSH Web and OneBot voice conversations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6789-6/dsh-voice-conversation-qq-web.git"
  },
  "homepage": "https://github.com/6789-6/dsh-voice-conversation-qq-web#readme",
  "bugs": "https://github.com/6789-6/dsh-voice-conversation-qq-web/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./bridge": "./src/bridge.js"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "onebot",
    "fish-audio",
    "asr",
    "tts"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "bundledDependencies": [
    "ws"
  ],
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "examples",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "bridge": "node bin/voice-bridge.js"
  }
}
